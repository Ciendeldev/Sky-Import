{
  "name": "sky-import",
  "version": "1.0.0",
  "private": true,
  "description": "Sky Import — componentes para PC. Ciudad del Este, Paraguay.",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "npm@11.17.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "a11y": "playwright test accesibilidad",
    "e2e:install": "playwright install --with-deps chromium",
    "assets": "node scripts/build-assets.mjs",
    "size": "size-limit",
    "admin:crear": "node --env-file=.env.local scripts/crear-admin.mjs",
    "hooks": "lefthook install",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.5",
    "@supabase/supabase-js": "^2.112.4",
    "next": "^16.3.4",
    "ogl": "^1.0.11",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "three": "0.185.1",
    "zustand": "5.0.14"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "1.62.1",
    "@size-limit/file": "^13.0.3",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^22.18.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.185.0",
    "axe-core": "^4.12.1",
    "eslint": "^9.39.0",
    "eslint-config-next": "^16.3.4",
    "lefthook": "^2.1.12",
    "sharp": "^0.35.3",
    "size-limit": "^13.0.3",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
