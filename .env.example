# ═══════════════════════════════════════════════════════════════════════════
# SKY IMPORT — variables de entorno
#
# Copiá este archivo como `.env.local` y completá los valores reales.
# `.env.local` está en `.gitignore`: NUNCA se sube al repositorio.
#
# En Vercel, estas mismas claves se cargan en
#   Project → Settings → Environment Variables
# ═══════════════════════════════════════════════════════════════════════════

# ── Supabase ──────────────────────────────────────────────────────────────
# Panel de Supabase → Project Settings → API

# URL del proyecto. Es pública: viaja al navegador.
NEXT_PUBLIC_SUPABASE_URL=https://bhlkdinovdhtwxkkujic.supabase.co

# Clave anónima. También es pública POR DISEÑO: lo que protege los datos son
# las políticas RLS, no el secreto de esta clave.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clave de servicio (o «secret key»). SALTA TODAS LAS POLÍTICAS RLS.
# Solo en el servidor. Si aparece en un componente de cliente, la base queda
# abierta a cualquiera que mire el código fuente de la página.
#
# OPCIONAL: la tienda y el panel funcionan sin ella, porque todo lo demás pasa
# por RLS con la sesión del operador. Solo hace falta para UNA cosa:
# `scripts/crear-admin.mjs`, que da de alta la cuenta de administración. Una vez
# creada la cuenta, se puede quitar del despliegue.
SUPABASE_SERVICE_ROLE_KEY=

# ── Administración ────────────────────────────────────────────────────────
# El usuario del panel. La contraseña NO vive acá: vive en Supabase Auth,
# hasheada. Este valor solo dice qué nombre de usuario se traduce a qué cuenta.
ADMIN_USERNAME=Cielo

# Correo interno con el que se creó esa cuenta en Supabase Auth. Nunca se
# muestra en la interfaz; el panel pide «usuario», no «correo».
ADMIN_EMAIL=cielo@skyimport.local

# ── Sitio ─────────────────────────────────────────────────────────────────
# Dominio público, sin barra final. Se usa para las URLs absolutas de la
# metadata, el sitemap y el enlace que viaja en los mensajes de WhatsApp.
NEXT_PUBLIC_SITE_ORIGIN=https://sky-import-jet.vercel.app
